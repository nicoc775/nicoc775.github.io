* {

    scroll-behavior: smooth;
    font-family: system-ui;
    box-sizing: border-box;
    color: white;
}

body {
    background-color: var(--bg);
    color: white;
}

a {
    text-decoration: none;
    background-color: var(--bg);
}



header, main, footer, nav{

    border: 1px solid black;
    padding: 2%;
    min-height: 20vh
}


main {
    min-height: 60vh;
}

main h2 {
    text-align: center;
}



nav a {
    border: 1px solid black;
    padding: 1rem;
    display: block;
    background-color: var(--bg2);
    border-radius: 10px;
}

:root {

    --bg: #060e4e;
    --bg2: rgb(1, 3, 95);

}



.solar main {
    padding: 20px;
}

.solar h2 {
    text-align: center;
}




.card {
    text-align: center;
    text-decoration: none;
    display: block;  
    border: 2px solid black;
    border-radius: 10px;
}

.solar img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;

    border-radius: 15px;

    transition:
        transform 0.4s ease,
        border-radius 0.4s ease,
        box-shadow 0.4s ease;
}

/* Hover-effekt */
.solar img:hover {
    transform: scale(1.05);
    border-radius: 15px;

  
}



.mars img{
    height: 100%;
}
@media(min-width:600px) {
    nav {
        display: grid;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        grid-template-columns: auto auto auto;
    }
    
    nav h2 {
        grid-column: span 3;
        /*  */
        text-align: center;
    }

    .solar  {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 30px;    
    
        
    }
    .solar>*{
        grid-column: span 2;  /* alla cards tar upp två kolumner nu när vi har 6 st */
    }
    .nLast{
        grid-column:2 / 4; /*  start vid kolumn 2 och avsluta vid kolumn 4  sista radens första card */
           
    }
    .solartitle{

    grid-column: span 6;

}


    }





.solar .card div{

padding: 0;
    aspect-ratio: 1/1;
    overflow: hidden;

}

.solar .card h2{

    place-items: center;
    aspect-ratio: 1/1;
}


.planet img {
    width: 100%;
    height: 100%;
    border-radius: 30px;
}